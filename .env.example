# Port used by the RSS bridge for the container listener, host publishing,
# Angelic Angel webhook target, and health check.
BRIDGE_PORT=8080

# Title shown in the RSS channel metadata.
FEED_TITLE=Angelic Angel

# Public URL associated with the RSS channel.
# Set this to the URL your RSS reader uses to access the feed.
FEED_LINK=http://localhost:8080/rss

# Maximum number of recent entries returned by the RSS feed.
MAX_ITEMS=100

# Angelic Angel log level. Common values include error, warn, info, debug, and trace.
RUST_LOG=info
